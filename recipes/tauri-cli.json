{
  "schemaVersion": 1,
  "id": "tauri-cli",
  "recipeVersion": 1,
  "source": {
    "repository": "https://github.com/tauri-apps/tauri",
    "revision": "c8c75b1f7f43e7cb1e7d773ed2f6f96fad2fe975"
  },
  "toolchain": "nightly-2026-09-28",
  "command": "cargo",
  "arguments": ["+{toolchain}", "install", "--git", "{repository}", "--rev", "{revision}", "tauri-cli", "--locked", "--target", "{target}", "--root", "{root}", "--force"],
  "verificationArgs": ["tauri", "--version"],
  "executable": "bin/cargo-tauri",
  "metadataManifest": "crates/tauri-cli/Cargo.toml",
  "metadataPackage": "tauri-cli",
  "licenses": ["LICENSE-APACHE-2.0", "LICENSE-MIT"],
  "targets": [
    { "target": "x86_64-apple-darwin", "platform": "darwin", "arch": "x64", "runner": "macos-15-intel" },
    { "target": "aarch64-apple-darwin", "platform": "darwin", "arch": "arm64", "runner": "macos-15" },
    { "target": "x86_64-pc-windows-msvc", "platform": "win32", "arch": "x64", "runner": "windows-2022" },
    { "target": "aarch64-pc-windows-msvc", "platform": "win32", "arch": "arm64", "runner": "windows-11-arm" },
    { "target": "x86_64-unknown-linux-gnu", "platform": "linux", "arch": "x64", "runner": "ubuntu-22.04" },
    { "target": "aarch64-unknown-linux-gnu", "platform": "linux", "arch": "arm64", "runner": "ubuntu-22.04-arm" }
  ]
}
